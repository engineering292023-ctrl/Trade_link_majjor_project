# TradeLink Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Database
MONGO_URI=mongodb://localhost:27017/tradelink
DB_NAME=tradelink

# Server & Security
SECRET_KEY=your_super_secret_jwt_key_change_me
PORT=8000
HOST=0.0.0.0

# Gemini AI API Keys (Primary & Optional Failovers)
GEMINI_API_KEY_1=AIzaSyYourGeminiApiKeyHere
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH=service-account.json

# Razorpay / Payment Gateway (Optional / Mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / SMTP Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
